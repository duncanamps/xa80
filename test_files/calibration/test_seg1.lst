
Assembly Listing                                                                                                 Page: 1
------------------------------------------------------------------------------------------------------------------------

                            1 | ;        TITLE   'HELLO_SEG.Z80 - Hello World with Segments'
                            2 | 
                            3 |                 EXTERN  WRITESTR
                            4 |                 EXTERN  MALLOC
                            5 | 
                            6 |                 GLOBAL  HELLO
                            7 |                 
                            8 | PRINT   MACRO   stringaddr
                            9 |         LD      DE,{stringaddr}
                           10 |         CALL    WRITESTR
                           11 |         ENDM
                           12 |                 
                           13 | ;============================================================================       
                           14 |         SEGMENT CSEG, FIXED, READONLY
                           15 | ;============================================================================       
                           16 |         
                           17 |         ORG     0100H
                           18 | 
                           19 | 
                           20 | HELLO:
0100: ED 73 00 00          21 |         LD      (SAVSP),SP      ; Save stack pointer
0104: 31 00 01             22 |         LD      SP,STACKEND     ; Set up new stack pointer
                           23 |         PRINT   MSG             ; Print the "Hello World" message
0107: 11 00 00             23 |         LD      DE,MSG
010A: CD 00 00             23 |         CALL    WRITESTR
010D: ED 7B 00 00          24 |         LD      SP,(SAVSP)      ; Get old stack pointer back
                           25 | GOBACK:     
0111: C9                   26 |         RET                     ; Back to caller
                           27 | 
                           28 | ;============================================================================       
                           29 |         SEGMENT VARS, RELOCATABLE, READWRITE
                           30 | ;============================================================================       
                           31 | 
0000: 00 00                32 | SAVSP:  DW      0               ; Saved stack pointer on entry
                           33 |         
                           34 | ;============================================================================       
                           35 |         SEGMENT DATA, RELOCATABLE, READONLY
                           36 | ;============================================================================       
                           37 | 
                           38 | ; Text strings
                           39 | 
                           40 | 
0000: 48 65 6C 6C 6F...    41 | MSG:        DB      'Hello World',13,10
000D: 43 72 65 61 74...    42 |             DB      'Created with XA80 cross assembler',13,10
0030: 2D 2D 2D 2D 2D...    43 |             DB      '---------------------------------',13,10,10
0054: 24                   44 |             DB      '$'
                           45 |         
                           46 | ;============================================================================       
                           47 |         SEGMENT STACK, RELOCATABLE, READWRITE, UNINITIALISED
                           48 | ;============================================================================       
                           49 | 
0000:                      50 | STACKBASE:  DS      256
                           51 | STACKEND:       
                           52 |             
                           53 |         END
                           54 |         

