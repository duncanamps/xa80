                           33 | ;
                           34 | ; Test macro definition, expansion and nesting
                           35 | ;
                           36 | ;----------------------------------------------------------------------------
                           37 | 
                           38 | ; Set up a simple macro
                           39 | 
                           40 | NOP3        MACRO
                           41 |             NOP
                           42 |             NOP
                           43 |             NOP
                           44 |             ENDM
                           45 |             
                           46 | ; Set up a nested macro with parameters
                           47 |             
                           48 | DELAY       MACRO   CYCLES
                           49 |             LD      A,{CYCLES}
                           50 |             OR      A,A
                           51 |             JR      Z,DELAYX{#}
                           52 |             LD      B,A
                           53 | DELAY{#}:   NOP3
                           54 |             DJNZ    DELAY{#}
                           55 | DELAYX{#}:
                           56 |             ENDM
                           57 |             
                           58 | ; Now invoke the macro
                           59 | 
                           60 |             DELAY   123
