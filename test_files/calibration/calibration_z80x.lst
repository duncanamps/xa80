                         1290 | 
                         1291 | ; Set up a simple macro
                         1292 | 
                         1293 | NOP3        MACRO
                         1294 |             NOP
                         1295 |             NOP
                         1296 |             NOP
                         1297 |             ENDM
                         1298 |             
                         1299 | ; Set up a nested macro with parameters
                         1300 |             
                         1301 | DELAY       MACRO   CYCLES
                         1302 |             LD      A,{CYCLES}
                         1303 |             OR      A,A
                         1304 |             JR      Z,DELAYX{#}
                         1305 |             LD      B,A
                         1306 | DELAY{#}:   NOP3
                         1307 |             DJNZ    DELAY{#}
                         1308 | DELAYX{#}:
                         1309 |             ENDM
                         1310 |             
                         1311 | ; Now invoke the macro
                         1312 | 
                         1313 |             DELAY   123
