                          981 | ;
                          982 | ; Test macro definition, expansion and nesting
                          983 | ;
                          984 | ;----------------------------------------------------------------------------
                          985 | 
                          986 | ; Set up a simple macro
                          987 | 
                          988 | NOP3        MACRO
                          989 |             NOP
                          990 |             NOP
                          991 |             NOP
                          992 |             ENDM
                          993 |             
                          994 | ; Set up a nested macro with parameters
                          995 |             
                          996 | DELAY       MACRO   CYCLES
                          997 |             LD      A,{CYCLES}
                          998 |             OR      A,A
                          999 |             JR      Z,DELAYX{#}
                         1000 |             LD      B,A
                         1001 | DELAY{#}:   NOP3
                         1002 |             DJNZ    DELAY{#}
                         1003 | DELAYX{#}:
                         1004 |             ENDM
                         1005 |             
                         1006 | ; Now invoke the macro
                         1007 | 
                         1008 |             DELAY   123


