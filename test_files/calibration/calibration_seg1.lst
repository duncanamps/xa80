                            1 | ;        TITLE   'HELLO_SEG.Z80 - Hello World with Segments'
                            2 | 
                            3 |                 EXTERN  WRITESTR
                            4 |                 EXTERN  MALLOC
                            5 | 
                            6 | CONST_STR       EQU     "String Constant"
                            7 | CONST_WORD      EQU     0x55aa
                            8 | 
                            9 |                 GLOBAL  HELLO
                           10 |                 
                           11 | PRINT   MACRO   stringaddr
                           12 |         LD      DE,{stringaddr}
                           13 |         CALL    WRITESTR
                           14 |         ENDM
                           15 |                 
                           16 | ;============================================================================       
                           17 |         SEGMENT CSEG, FIXED, READONLY
                           18 | ;============================================================================       
                           19 |         
                           20 |         ORG     0100H
                           21 | 
                           22 | 
                           23 | HELLO:
0100: ED 73 00 00          24 |         LD      (SAVSP),SP      ; Save stack pointer
0104: 31 00 01             25 |         LD      SP,STACKEND     ; Set up new stack pointer
                           26 |         PRINT   MSG             ; Print the "Hello World" message
0107: 11 00 00             26 |         LD      DE,MSG
010A: CD 00 00             26 |         CALL    WRITESTR
010D: ED 7B 00 00          27 |         LD      SP,(SAVSP)      ; Get old stack pointer back
                           28 | GOBACK:     
0111: C9                   29 |         RET                     ; Back to caller
                           30 | 
                           31 | ;============================================================================       
                           32 |         SEGMENT VARS, RELOCATABLE, READWRITE
                           33 | ;============================================================================       
                           34 | 
0000: 00 00                35 | SAVSP:  DW      0               ; Saved stack pointer on entry
                           36 |         
                           37 | ;============================================================================       
                           38 |         SEGMENT DATA, RELOCATABLE, READONLY
                           39 | ;============================================================================       
                           40 | 
                           41 | ; Text strings
                           42 | 
                           43 | 
0000: 48 65 6C 6C 6F...    44 | MSG:        DB      'Hello World',13,10
000D: 43 72 65 61 74...    45 |             DB      'Created with XA80 cross assembler',13,10
0030: 2D 2D 2D 2D 2D...    46 |             DB      '---------------------------------',13,10,10
0054: 24                   47 |             DB      '$'
                           48 |         
                           49 | ;============================================================================       
                           50 |         SEGMENT STACK, RELOCATABLE, READWRITE, UNINITIALISED
                           51 | ;============================================================================       
                           52 | 
0000:                      53 | STACKBASE:  DS      256
                           54 | STACKEND:       


