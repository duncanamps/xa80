                          167 |         
                          168 |         IF 1
                          169 |             MSGINFO "Good"
                          170 |         ELSE
                          171 :             MSGERROR "BAD!"
                          172 :         ENDIF
                          173 |         
                          174 |         ; Check IF for a false value
                          175 |         
                          176 |         IF 0
                          177 :             MSGERROR "BAD!"
                          178 :         ELSE
                          179 |             MSGINFO "Good"
                          180 |         ENDIF
                          181 | 
                          182 |         ; Check nesting
                          183 |         
                          184 |         IF 1
                          185 |           MSGINFO "Good"
                          186 |           IF 0
                          187 :             MSGERROR "Bad"
                          188 :           ELSE
                          189 |             MSGINFO "Good"
                          190 |           ENDIF
                          191 |         ELSE
                          192 :           MSGERROR "Bad"
                          193 :           IF 1
                          194 :             MSGERROR "Also bad"
                          195 :           ELSE
                          196 :             MSGERROR "Also bad"
                          197 :           ENDIF
                          198 :         ENDIF
