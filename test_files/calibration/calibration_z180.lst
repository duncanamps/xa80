                           32 | ;
                           33 | ; Test macro definition, expansion and nesting
                           34 | ;
                           35 | ;----------------------------------------------------------------------------
                           36 | 
                           37 | ; Set up a simple macro
                           38 | 
                           39 | NOP3        MACRO
                           40 |             NOP
                           41 |             NOP
                           42 |             NOP
                           43 |             ENDM
                           44 |             
                           45 | ; Set up a nested macro with parameters
                           46 |             
                           47 | DELAY       MACRO   CYCLES
                           48 |             LD      A,{CYCLES}
                           49 |             OR      A,A
                           50 |             JR      Z,DELAYX{#}
                           51 |             LD      B,A
                           52 | DELAY{#}:   NOP3
                           53 |             DJNZ    DELAY{#}
                           54 | DELAYX{#}:
                           55 |             ENDM
                           56 |             
                           57 | ; Now invoke the macro
                           58 | 
                           59 |             DELAY   123
